{
  "name": "electron-demo",
  "version": "1.0.0",
  "description": "Electron demo",
  "license": "ISC",
  "author": "lilei",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:web": "npm --prefix frontend run dev",
    "build:web": "npm --prefix frontend run build:prod",
    "dist": "npm run build:web && electron-builder --win nsis",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lilei.electron-demo",
    "productName": "ERP工作台",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "frontend/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERP工作台"
    }
  }
}
